# OpenAtlas configuration — copy to .env (or .env.private) and tune.
# NOTE: There are NO paid API keys here. Everything is free/keyless/local.

# ---- Local LLM (Ollama) — replaces OpenAI/VertexAI --------------------------------
# Start Ollama with `ollama serve` and pull models, e.g.:
#   ollama pull llama3.1:8b
#   ollama pull llava            # vision, for image geolocation
OLLAMA_HOST=http://localhost:11434
OPENATLAS_LLM_MODEL=llama3.1:8b
OPENATLAS_VISION_MODEL=llava:7b
# OPENATLAS_LLM_TIMEOUT=60
# OPENATLAS_LLM_TEMPERATURE=0.2

# ---- Database (SQLite default; MySQL/Postgres optional, all free) ------------------
OPENATLAS_DB_BACKEND=sqlite
# OPENATLAS_SQLITE_PATH=./data/openatlas.db
# For MySQL/Postgres, either set a full URL:
# OPENATLAS_DB_URL=postgresql+psycopg://user:pass@localhost:5432/openatlas
# ...or the individual fields:
# OPENATLAS_DB_HOST=localhost
# OPENATLAS_DB_NAME=openatlas
# OPENATLAS_DB_USER=openatlas
# OPENATLAS_DB_PASSWORD=

# ---- HTTP behaviour ---------------------------------------------------------------
# OPENATLAS_USER_AGENT="OpenAtlas-OSINT/0.1 (+https://github.com/voidless026-design/Map; public-data-only)"
# OPENATLAS_HTTP_TIMEOUT=20

# ---- Local ML (optional, heavy) — replaces isgen.ai / DeepFace cloud --------------
# OPENATLAS_DEEPFAKE_MODEL=prithivMLmods/Deep-Fake-Detector-v2-Model

# ---- Web UI -----------------------------------------------------------------------
# OPENATLAS_WEB_HOST=127.0.0.1
# OPENATLAS_WEB_PORT=8501
